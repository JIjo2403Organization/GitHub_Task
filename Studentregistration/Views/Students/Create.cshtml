@model StudentRegistration

<script type="text/javascript">
    function SetValue() {
        $("#courseid").val($("#courseid").val());
        $("#batchid").val($("#batchid").val());
    }
</script>

<div class="container shadow p-5">
    <div class="row pb-2">
        <h2>Add Registration</h2>
    </div>

    <form method="post">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="FirstName">First Name</label>
                <input type="text" class="form-control mb-3" asp-for="FirstName" placeholder="Enter First Name">
                <span asp-validation-for="FirstName" class=" alert-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="LastName">Last Name</label>
                <input type="text" class="form-control mb-3" asp-for="LastName" placeholder="Enter Last Name">
                <span asp-validation-for="LastName" class=" alert-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="phone">phone No</label>
                <input type="number" class="form-control mb-3" asp-for="phone" placeholder="Enter Phone No">
                <span asp-validation-for="phone" class=" alert-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Course_Id">Course</label>
                <select asp-for="Course_Id" class="form-select m-0" id="courseid" asp-items="@(new SelectList(ViewBag.listofcourses,"Id","CourseName","Id"))" onchange="SetValue()">
                    <option value="0">Select a Course</option>
                </select>
                <span asp-validation-for="Course_Id" class=" alert-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Batch_id">Batch</label>
                <select asp-for="Batch_id" class="form-select m-0" id="batchid" asp-items="@(new SelectList(ViewBag.listofbatches,"Id","BatchName","Id"))" onchange="SetValue()">
                    <option value="0">Select a Batch</option>
                </select>
                <span asp-validation-for="Batch_id" class=" alert-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <button type="submit" class="btn btn-lg btn-primary p-2"><i class="bi bi-file-plus-fill"></i>Save</button>
                <a asp-controller="Students" asp-action="Index" class="btn btn-lg btn-warning p-2">Back To List</a>
            </div>
        </div>
    </form>

</div>


@*//for front end validations*@

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
